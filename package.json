{
  "name": "unilife-ethiopia",
  "version": "1.0.0",
  "description": "UniLife Ethiopia - Complete Student Life Organizer Platform (Responsive Web & PWA)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:server": "node --watch backend/src/server.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node backend/src/server.js",
    "setup-admin": "node backend/src/scripts/setup-admin.js",
    "migrate": "node backend/src/db/migrate.js",
    "seed": "node backend/src/db/seed.js",
    "test": "node backend/tests/run-tests.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "chart.js": "^4.4.7",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.12.0",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  },
  "keywords": [
    "unilife",
    "ethiopia",
    "student-organizer",
    "pwa",
    "fullstack"
  ],
